# ksqlDB Configuration
# Endpoint expuesto públicamente por tu entorno Confluent Platform
# Ejemplo: https://<IP-del-VM>/ksqldb
KSQLDB_ENDPOINT=https://<host>/ksqldb

# Credenciales HTTP Basic para ksqlDB (las mismas que Control Center)
KSQLDB_API_KEY=admin
KSQLDB_API_SECRET=<ksqldb-password>

# Kafka Configuration (brokers nativos, protocolo SASL_SSL)
# Ejemplo: 163.66.86.231:9094,163.66.86.231:9095,163.66.86.231:9096
BOOTSTRAP_SERVERS=<host>:9094,<host>:9095,<host>:9096

# Credenciales Kafka (cuenta kafka-admin, separada de la de admin)
KAFKA_API_KEY=kafka-admin
KAFKA_API_SECRET=<kafka-password>

# Nombre del topic de inventario
TOPIC_NAME=inventory.transactions
